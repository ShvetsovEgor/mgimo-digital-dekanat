# Пример конфигурации. Реальные значения задаются в панели хостинга (переменные окружения),
# НИКОГДА не коммитятся в репозиторий.
NODE_ENV=production
PORT=8080
TZ=Europe/Moscow
DATA_DIR=./data

# Публичный адрес прототипа (используется в QR-кодах документов)
PUBLIC_URL=https://example.onrender.com

# Секрет HMAC для проверки подлинности документов (сгенерируйте длинную случайную строку)
DOC_VERIFY_SECRET=change-me-please-32-bytes-minimum
# Соль для хеширования IP (необязательно, по умолчанию выводится из DOC_VERIFY_SECRET)
IP_SALT=
# Пароль демо-аккаунтов (публичный, показывается жюри на экране входа)
DEMO_PASSWORD=DemoKonkurs2030
