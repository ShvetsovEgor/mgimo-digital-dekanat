{
  "name": "deadline-digital-dekanat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "«Дедлайн» — Цифровой деканат 2030. Концепт личного кабинета студента МГИМО для конкурса. Неофициальный сервис.",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web && npm run build -w server",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "test": "npm run test -w server",
    "doctor": "node scripts/doctor.mjs",
    "smoke": "node scripts/smoke.mjs",
    "screens": "node scripts/screens.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.55.0"
  }
}
